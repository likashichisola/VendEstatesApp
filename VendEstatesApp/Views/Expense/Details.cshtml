@model VendEstatesApp.Models.Expense
@{
    ViewData["Title"] = "Expense Details";
    var statusBadge = Model.Status switch
    {
        VendEstatesApp.Models.Enums.ExpenseStatus.Approved => "success",
        VendEstatesApp.Models.Enums.ExpenseStatus.Paid => "primary",
        VendEstatesApp.Models.Enums.ExpenseStatus.Rejected => "danger",
        _ => "warning"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Expense - @Model.Title</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Requested By</dt>
            <dd class="col-sm-9">@Model.RequestedByEmployee?.FullName</dd>
            <dt class="col-sm-3">Expense Date</dt>
            <dd class="col-sm-9">@Model.ExpenseDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">K@(Model.Amount.ToString("N2"))</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-@statusBadge">@Model.Status</span></dd>
            <dt class="col-sm-3">Approved By</dt>
            <dd class="col-sm-9">@(Model.ApprovedByEmployee?.FullName ?? "-")</dd>
            @if (Model.Status == VendEstatesApp.Models.Enums.ExpenseStatus.Rejected)
            {
                <dt class="col-sm-3">Rejection Reason</dt>
                <dd class="col-sm-9">@Model.RejectionReason</dd>
            }
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        @if (Model.Status == VendEstatesApp.Models.Enums.ExpenseStatus.Pending && (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approve</button>
            </form>
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <i class="bi bi-x-lg"></i> Reject
            </button>
        }
        @if (Model.Status == VendEstatesApp.Models.Enums.ExpenseStatus.Approved && (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
        {
            <form asp-action="MarkPaid" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-cash-coin"></i> Mark as Paid</button>
            </form>
        }
        @if ((User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this expense request?');">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
    </div>
</div>

@if (Model.Status == VendEstatesApp.Models.Enums.ExpenseStatus.Pending && (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Reject Expense</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Reason</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
