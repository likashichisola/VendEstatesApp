@model IEnumerable<VendEstatesApp.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Expenses</h4>
    @if (User.IsInRole("Director") || User.IsInRole("Accountant"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Expense</a>
    }
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Branch</th>
                    <th>Requested By</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in Model)
                {
                    var statusBadge = expense.Status switch
                    {
                        VendEstatesApp.Models.Enums.ExpenseStatus.Approved => "success",
                        VendEstatesApp.Models.Enums.ExpenseStatus.Paid => "primary",
                        VendEstatesApp.Models.Enums.ExpenseStatus.Rejected => "danger",
                        _ => "warning"
                    };
                    <tr>
                        <td>@expense.Title</td>
                        <td>@expense.Category</td>
                        <td>@expense.Branch?.Name</td>
                        <td>@expense.RequestedByEmployee?.FullName</td>
                        <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                        <td>K@expense.Amount.ToString("N2")</td>
                        <td><span class="badge bg-@statusBadge">@expense.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@expense.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
