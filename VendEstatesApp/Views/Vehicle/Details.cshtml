@model VendEstatesApp.Models.Vehicle
@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@Model.Make @Model.Model</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Registration Number</dt>
            <dd class="col-sm-9">@Model.RegistrationNumber</dd>
            <dt class="col-sm-3">Make / Model</dt>
            <dd class="col-sm-9">@Model.Make @Model.Model</dd>
            <dt class="col-sm-3">Year</dt>
            <dd class="col-sm-9">@Model.Year</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Daily Rate</dt>
            <dd class="col-sm-9">K@(Model.DailyRate.ToString("N2"))</dd>
            <dt class="col-sm-3">Color</dt>
            <dd class="col-sm-9">@(Model.Color ?? "-")</dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
        </dl>
    </div>
    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
    {
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        </div>
    }
</div>
