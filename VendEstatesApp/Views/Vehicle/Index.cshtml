@model IEnumerable<VendEstatesApp.Models.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Vehicles</h4>
    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Vehicle</a>
    }
</div>

<div class="row g-3">
    @foreach (var vehicle in Model)
    {
        var statusBadge = vehicle.Status switch
        {
            VendEstatesApp.Models.Enums.VehicleStatus.Available => "success",
            VendEstatesApp.Models.Enums.VehicleStatus.Rented => "danger",
            VendEstatesApp.Models.Enums.VehicleStatus.Maintenance => "warning",
            _ => "secondary"
        };
        <div class="col-md-4 col-lg-3">
            <div class="card booking-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1">@vehicle.Make @vehicle.Model</h5>
                        <span class="badge bg-@statusBadge">@vehicle.Status</span>
                    </div>
                    <p class="text-muted mb-1">@vehicle.RegistrationNumber · @vehicle.Category</p>
                    <p class="mb-1"><i class="bi bi-calendar3"></i> @vehicle.Year · @vehicle.Branch?.Name</p>
                    <p class="fw-semibold mb-0">K@vehicle.DailyRate.ToString("N2") / day</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
                    {
                        <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
