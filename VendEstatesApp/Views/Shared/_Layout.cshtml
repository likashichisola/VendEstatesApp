@using Microsoft.AspNetCore.Authentication.Cookies
@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string controller) => string.Equals(controllerName, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vend Estates Management System</title>

    <!-- PWA: manifest, theme color, and platform icons -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#1b6ec2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Vend Estates" />
    <link rel="apple-touch-icon" href="~/icons/icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/icons/icon-192x192.png" />
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-building"></i>
                <span class="brand-text">Vend Estates</span>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Lodge</li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Room") ? "active" : "")" asp-controller="Room" asp-action="Index">
                            <i class="bi bi-door-closed"></i> <span>Rooms</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Booking") ? "active" : "")" asp-controller="Booking" asp-action="Index">
                            <i class="bi bi-calendar-check"></i> <span>Bookings</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Car Rental</li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Vehicle") ? "active" : "")" asp-controller="Vehicle" asp-action="Index">
                            <i class="bi bi-car-front"></i> <span>Vehicles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("VehicleBooking") ? "active" : "")" asp-controller="VehicleBooking" asp-action="Index">
                            <i class="bi bi-calendar2-week"></i> <span>Rental Bookings</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Agro Field</li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("AgroInventory") ? "active" : "")" asp-controller="AgroInventory" asp-action="Index">
                            <i class="bi bi-box-seam"></i> <span>Inventory</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("AgroSale") ? "active" : "")" asp-controller="AgroSale" asp-action="Index">
                            <i class="bi bi-cash-coin"></i> <span>Sales</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Human Resources</li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Employee") ? "active" : "")" asp-controller="Employee" asp-action="Index">
                            <i class="bi bi-people"></i> <span>Employees</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Leave") ? "active" : "")" asp-controller="Leave" asp-action="Index">
                            <i class="bi bi-airplane"></i> <span>Leave</span>
                        </a>
                    </li>
                    @if ((User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Contract") ? "active" : "")" asp-controller="Contract" asp-action="Index">
                                <i class="bi bi-file-earmark-text"></i> <span>Contracts</span>
                            </a>
                        </li>
                    }

                    <li class="nav-section-title">Finance</li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Payroll") ? "active" : "")" asp-controller="Payroll" asp-action="Index">
                            <i class="bi bi-wallet2"></i> <span>Payroll</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Expense") ? "active" : "")" asp-controller="Expense" asp-action="Index">
                            <i class="bi bi-receipt"></i> <span>Expenses</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Payment") ? "active" : "")" asp-controller="Payment" asp-action="Index">
                            <i class="bi bi-credit-card"></i> <span>Payments</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Report") ? "active" : "")" asp-controller="Report" asp-action="Index">
                                <i class="bi bi-bar-chart"></i> <span>Reports</span>
                            </a>
                        </li>
                    }
                    @if ((User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant")))
                    {
                        <li class="nav-section-title">Administration</li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Branch") ? "active" : "")" asp-controller="Branch" asp-action="Index">
                                <i class="bi bi-diagram-3"></i> <span>Branches</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </aside>

        <div class="main-content">
            <header class="topbar">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary d-none d-lg-inline-block" id="sidebarCollapseToggle" type="button">
                    <i class="bi bi-layout-sidebar"></i>
                </button>

                <div class="topbar-title d-none d-md-block">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>

                <ul class="navbar-nav flex-row align-items-center ms-auto">
                    <li class="nav-item">
                        <button id="pwaInstallButton" type="button" class="btn btn-sm btn-outline-primary d-none">
                            <i class="bi bi-download"></i> <span class="d-none d-md-inline">Install App</span>
                        </button>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Component.InvokeAsync("NotificationDropdown")

                        <li class="nav-item dropdown ms-3">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar-circle me-2">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper())</span>
                                <span class="d-none d-md-inline">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li><span class="dropdown-item-text text-muted small">Role: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </header>

            <main class="content-area">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
