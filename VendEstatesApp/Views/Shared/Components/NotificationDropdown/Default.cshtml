@model VendEstatesApp.ViewComponents.NotificationDropdownViewModel

<li class="nav-item dropdown">
    <a class="nav-link position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell fs-5"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @(Model.UnreadCount > 9 ? "9+" : Model.UnreadCount.ToString())
            </span>
        }
    </a>
    <ul class="dropdown-menu dropdown-menu-end notification-dropdown shadow" aria-labelledby="notificationDropdown">
        <li><h6 class="dropdown-header d-flex justify-content-between align-items-center">Notifications
            @if (Model.UnreadCount > 0)
            {
                <span class="badge bg-primary rounded-pill">@Model.UnreadCount new</span>
            }
        </h6></li>
        @if (!Model.Notifications.Any())
        {
            <li><span class="dropdown-item-text text-muted small">No notifications yet.</span></li>
        }
        else
        {
            foreach (var notification in Model.Notifications)
            {
                <li>
                    <a class="dropdown-item @(notification.IsRead ? "" : "fw-semibold bg-light")" href="@(notification.LinkUrl ?? "#")">
                        <div class="small">@notification.Title</div>
                        <div class="text-muted small text-truncate" style="max-width: 260px;">@notification.Message</div>
                        <div class="text-muted" style="font-size: 0.7rem;">@notification.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                    </a>
                </li>
            }
        }
        <li><hr class="dropdown-divider" /></li>
        <li class="px-3 d-flex justify-content-between align-items-center">
            <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post" class="mb-0">
                <button type="submit" class="btn btn-sm btn-link p-0">Mark all as read</button>
            </form>
            <a asp-controller="Notification" asp-action="Index" class="small">View all</a>
        </li>
    </ul>
</li>
