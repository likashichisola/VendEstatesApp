@model VendEstatesApp.Services.DashboardSummary
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-3">
    <h4 class="mb-0">Welcome back, @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</h4>
    <p class="text-muted">Here's what's happening across Vend Estates today.</p>
</div>

<div class="row g-3">
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-primary-soft">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Employees</div>
                    <h3 class="mb-0">@Model.TotalEmployees</h3>
                </div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-success-soft">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Branches</div>
                    <h3 class="mb-0">@Model.TotalBranches</h3>
                </div>
                <i class="bi bi-diagram-3 stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-info-soft">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Net Income (Month)</div>
                    <h3 class="mb-0">K@(Model.NetIncomeThisMonth.ToString("N2"))</h3>
                </div>
                <i class="bi bi-graph-up-arrow stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-warning-soft">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Low Stock Agro Items</div>
                    <h3 class="mb-0">@Model.LowStockAgroItems</h3>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-door-closed"></i> Lodge Overview
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-3">
                        <h4 class="mb-0">@Model.TotalRooms</h4>
                        <small class="text-muted">Total</small>
                    </div>
                    <div class="col-3">
                        <h4 class="mb-0 text-success">@Model.AvailableRooms</h4>
                        <small class="text-muted">Available</small>
                    </div>
                    <div class="col-3">
                        <h4 class="mb-0 text-danger">@Model.OccupiedRooms</h4>
                        <small class="text-muted">Occupied</small>
                    </div>
                    <div class="col-3">
                        <h4 class="mb-0 text-warning">@Model.ReservedRooms</h4>
                        <small class="text-muted">Reserved</small>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Total Bookings</span>
                    <strong>@Model.TotalBookings</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Active Bookings</span>
                    <strong>@Model.ActiveBookings</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Long-Term Stays</span>
                    <strong>@Model.LongTermBookings</strong>
                </div>
                <a asp-controller="Room" asp-action="Occupancy" class="btn btn-sm btn-outline-primary mt-2">View Occupancy</a>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-car-front"></i> Car Rental Overview
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-4">
                        <h4 class="mb-0">@Model.TotalVehicles</h4>
                        <small class="text-muted">Total</small>
                    </div>
                    <div class="col-4">
                        <h4 class="mb-0 text-success">@Model.AvailableVehicles</h4>
                        <small class="text-muted">Available</small>
                    </div>
                    <div class="col-4">
                        <h4 class="mb-0 text-danger">@Model.RentedVehicles</h4>
                        <small class="text-muted">Rented</small>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Active Rental Bookings</span>
                    <strong>@Model.ActiveVehicleBookings</strong>
                </div>
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">Manage Vehicles</a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-receipt"></i> Pending Expense Approvals
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-0">@Model.PendingExpenseApprovals</h2>
                <a asp-controller="Expense" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3">Review Expenses</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-wallet2"></i> Pending Payroll Approvals
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-0">@Model.PendingPayrollApprovals</h2>
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3">Review Payroll</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-airplane"></i> Pending Leave Approvals
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-0">@Model.PendingLeaveApprovals</h2>
                <a asp-controller="Leave" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3">Review Leave</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <i class="bi bi-cash-stack"></i> This Month's Finance Summary
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Total Income</div>
                        <h4 class="text-success mb-0">K@(Model.TotalIncomeThisMonth.ToString("N2"))</h4>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Total Expenses</div>
                        <h4 class="text-danger mb-0">K@(Model.TotalExpensesThisMonth.ToString("N2"))</h4>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Net Income</div>
                        <h4 class="mb-0">K@(Model.NetIncomeThisMonth.ToString("N2"))</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
