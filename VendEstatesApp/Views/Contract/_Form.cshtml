@model VendEstatesApp.ViewModels.Contract.ContractFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" class="form-select" asp-items="Model.EmployeeOptions">
            <option value="">-- Select Employee --</option>
        </select>
        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<VendEstatesApp.Models.Enums.ContractType>()"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VendEstatesApp.Models.Enums.ContractStatus>()"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="AgreedSalary" class="form-label"></label>
        <input asp-for="AgreedSalary" class="form-control" />
        <span asp-validation-for="AgreedSalary" class="text-danger small"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Terms" class="form-label"></label>
        <textarea asp-for="Terms" class="form-control" rows="3"></textarea>
    </div>
</div>
