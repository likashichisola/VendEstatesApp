@model IEnumerable<VendEstatesApp.Models.AgroSale>
@{
    ViewData["Title"] = "Agro Sales";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Agro Sales</h4>
    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Record Sale</a>
    }
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Customer</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                    <th>Sale Date</th>
                    <th>Sold By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model)
                {
                    <tr>
                        <td>@sale.AgroInventory?.ItemName</td>
                        <td>@(sale.CustomerName ?? "-")</td>
                        <td>@sale.QuantitySold.ToString("N2") @sale.AgroInventory?.Unit</td>
                        <td>K@sale.UnitPrice.ToString("N2")</td>
                        <td>K@sale.TotalAmount.ToString("N2")</td>
                        <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                        <td>@sale.SoldByEmployee?.FullName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
