@{
    ViewData["Title"] = "Reports";
}

<div class="mb-3">
    <h4 class="mb-0">Reports</h4>
    <p class="text-muted">Select a report to view detailed financial and payroll insights.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-graph-up display-5 text-primary"></i>
                <h5 class="mt-3">Income vs Expense</h5>
                <p class="text-muted small">Monthly breakdown of income, expenses, and net position for a selected year.</p>
                <a asp-action="IncomeExpense" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-diagram-3 display-5 text-warning"></i>
                <h5 class="mt-3">Expenses by Branch</h5>
                <p class="text-muted small">Compare approved/paid expenses across branches for a date range.</p>
                <a asp-action="BranchExpenses" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Director") || User.IsInRole("Accountant"))
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-wallet2 display-5 text-success"></i>
                    <h5 class="mt-3">Payroll Report</h5>
                    <p class="text-muted small">Review payroll totals and deductions for a specific month/year.</p>
                    <a asp-action="Payroll" class="btn btn-primary btn-sm">View Report</a>
                </div>
            </div>
        </div>
    }
</div>
