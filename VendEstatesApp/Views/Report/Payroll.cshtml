@model VendEstatesApp.ViewModels.Report.PayrollReportViewModel
@{
    ViewData["Title"] = "Payroll Report";
    var monthNames = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.MonthNames;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Payroll Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Reports</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@monthNames[m - 1]</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Year</label>
                <input type="number" name="year" class="form-control" value="@Model.Year" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card bg-primary-soft">
            <div class="card-body">
                <div class="small text-white-50">Total Gross Salary</div>
                <h4 class="mb-0">K@(Model.TotalGrossSalary.ToString("N2"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-danger-soft">
            <div class="card-body">
                <div class="small text-white-50">Total Deductions</div>
                <h4 class="mb-0">K@(Model.TotalDeductions.ToString("N2"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-success-soft">
            <div class="card-body">
                <div class="small text-white-50">Total Net Salary</div>
                <h4 class="mb-0">K@(Model.TotalNetSalary.ToString("N2"))</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        @if (!Model.Payrolls.Any())
        {
            <p class="text-muted mb-0">No payroll records found for the selected period.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Status</th>
                        <th>Gross Salary</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payroll in Model.Payrolls)
                    {
                        <tr>
                            <td>@payroll.Employee?.FullName</td>
                            <td>@payroll.Status</td>
                            <td>K@payroll.GrossSalary.ToString("N2")</td>
                            <td>K@payroll.TotalDeductions.ToString("N2")</td>
                            <td>K@payroll.NetSalary.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="2">Total</td>
                        <td>K@(Model.TotalGrossSalary.ToString("N2"))</td>
                        <td>K@(Model.TotalDeductions.ToString("N2"))</td>
                        <td>K@(Model.TotalNetSalary.ToString("N2"))</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>
