@model VendEstatesApp.ViewModels.Report.IncomeExpenseReportViewModel
@{
    ViewData["Title"] = "Income vs Expense Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Income vs Expense Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Reports</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Year</label>
                <select name="year" class="form-select" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card bg-success-soft">
            <div class="card-body">
                <div class="small text-white-50">Total Income</div>
                <h4 class="mb-0">K@(Model.TotalIncome.ToString("N2"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-danger-soft">
            <div class="card-body">
                <div class="small text-white-50">Total Expenses</div>
                <h4 class="mb-0">K@(Model.TotalExpenses.ToString("N2"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-primary-soft">
            <div class="card-body">
                <div class="small text-white-50">Net</div>
                <h4 class="mb-0">K@(Model.TotalNet.ToString("N2"))</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Income</th>
                    <th>Expenses</th>
                    <th>Net</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Period.ToString("MMMM yyyy")</td>
                        <td class="text-success">K@(row.Income.ToString("N2"))</td>
                        <td class="text-danger">K@(row.Expenses.ToString("N2"))</td>
                        <td>K@(row.Net.ToString("N2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td>Total</td>
                    <td class="text-success">K@(Model.TotalIncome.ToString("N2"))</td>
                    <td class="text-danger">K@(Model.TotalExpenses.ToString("N2"))</td>
                    <td>K@(Model.TotalNet.ToString("N2"))</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
