@model IEnumerable<VendEstatesApp.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Leave Requests</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Apply for Leave</a>
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    @if (User.IsInRole("Director") || User.IsInRole("Manager"))
                    {
                        <th>Employee</th>
                    }
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Days</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leave in Model)
                {
                    var statusBadge = leave.Status switch
                    {
                        VendEstatesApp.Models.Enums.LeaveStatus.Approved => "success",
                        VendEstatesApp.Models.Enums.LeaveStatus.Rejected => "danger",
                        VendEstatesApp.Models.Enums.LeaveStatus.Cancelled => "secondary",
                        _ => "warning"
                    };
                    <tr>
                        @if (User.IsInRole("Director") || User.IsInRole("Manager"))
                        {
                            <td>@leave.Employee?.FullName</td>
                        }
                        <td>@leave.Type</td>
                        <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                        <td>@leave.NumberOfDays</td>
                        <td><span class="badge bg-@statusBadge">@leave.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@leave.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
