@model VendEstatesApp.Models.Payment
@{
    ViewData["Title"] = "Payment Details";
    var statusBadge = Model.Status switch
    {
        VendEstatesApp.Models.Enums.PaymentStatus.Completed => "success",
        VendEstatesApp.Models.Enums.PaymentStatus.Approved => "primary",
        VendEstatesApp.Models.Enums.PaymentStatus.Rejected => "danger",
        _ => "warning"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Payment Details</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>
            <dt class="col-sm-3">Method</dt>
            <dd class="col-sm-9">@Model.Method</dd>
            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">K@(Model.Amount.ToString("N2"))</dd>
            <dt class="col-sm-3">Payment Date</dt>
            <dd class="col-sm-9">@Model.PaymentDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-@statusBadge">@Model.Status</span></dd>
            <dt class="col-sm-3">Reference Number</dt>
            <dd class="col-sm-9">@(Model.ReferenceNumber ?? "-")</dd>
            @if (Model.Booking is not null)
            {
                <dt class="col-sm-3">Booking</dt>
                <dd class="col-sm-9"><a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.Booking.Id">@Model.Booking.GuestName - Room @Model.Booking.Room?.RoomNumber</a></dd>
            }
            @if (Model.VehicleBooking is not null)
            {
                <dt class="col-sm-3">Vehicle Booking</dt>
                <dd class="col-sm-9">@Model.VehicleBooking.CustomerName - @Model.VehicleBooking.Vehicle?.RegistrationNumber</dd>
            }
            @if (Model.Expense is not null)
            {
                <dt class="col-sm-3">Expense</dt>
                <dd class="col-sm-9"><a asp-controller="Expense" asp-action="Details" asp-route-id="@Model.Expense.Id">@Model.Expense.Title</a></dd>
            }
            @if (Model.Payroll is not null)
            {
                <dt class="col-sm-3">Payroll</dt>
                <dd class="col-sm-9"><a asp-controller="Payroll" asp-action="Details" asp-route-id="@Model.Payroll.Id">@Model.Employee?.FullName - @Model.Payroll.PayrollMonth/@Model.Payroll.PayrollYear</a></dd>
            }
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
        </dl>
    </div>
</div>
