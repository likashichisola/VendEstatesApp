@model IEnumerable<VendEstatesApp.Models.Branch>
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Branches</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Branch</a>
</div>

<div class="row g-3">
    @foreach (var branch in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title">@branch.Name</h5>
                        @if (branch.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                    <p class="text-muted mb-1"><i class="bi bi-tag"></i> @branch.Type</p>
                    <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @branch.Location</p>
                    <p class="text-muted mb-1"><i class="bi bi-telephone"></i> @branch.ContactPhone</p>
                    <p class="text-muted"><i class="bi bi-envelope"></i> @branch.ContactEmail</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                </div>
            </div>
        </div>
    }
</div>
