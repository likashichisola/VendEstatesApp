@model VendEstatesApp.Models.Branch
@{
    ViewData["Title"] = "Branch Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Branch Details</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>
            <dt class="col-sm-3">Contact Phone</dt>
            <dd class="col-sm-9">@Model.ContactPhone</dd>
            <dt class="col-sm-3">Contact Email</dt>
            <dd class="col-sm-9">@Model.ContactEmail</dd>
            <dt class="col-sm-3">Employees</dt>
            <dd class="col-sm-9">@Model.Employees.Count</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>
