@model VendEstatesApp.Models.AgroInventory
@{
    ViewData["Title"] = "Agro Inventory Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@Model.ItemName</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Item Name</dt>
            <dd class="col-sm-9">@Model.ItemName</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Unit</dt>
            <dd class="col-sm-9">@Model.Unit</dd>
            <dt class="col-sm-3">Quantity In Stock</dt>
            <dd class="col-sm-9">@Model.QuantityInStock</dd>
            <dt class="col-sm-3">Unit Cost</dt>
            <dd class="col-sm-9">K@(Model.UnitCost.ToString("N2"))</dd>
            <dt class="col-sm-3">Reorder Level</dt>
            <dd class="col-sm-9">@Model.ReorderLevel</dd>
            <dt class="col-sm-3">Low Stock</dt>
            <dd class="col-sm-9">
                @if (Model.IsLowStock)
                {
                    <span class="badge bg-danger">Yes</span>
                }
                else
                {
                    <span class="badge bg-success">No</span>
                }
            </dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
        </dl>
    </div>
    @if (User.IsInRole("Director") || User.IsInRole("Manager") || User.IsInRole("Accountant"))
    {
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        </div>
    }
</div>
