@model VendEstatesApp.Models.VehicleBooking
@{
    ViewData["Title"] = "Rental Booking Details";
    var statusBadge = Model.Status switch
    {
        VendEstatesApp.Models.Enums.VehicleBookingStatus.Active => "success",
        VendEstatesApp.Models.Enums.VehicleBookingStatus.Completed => "secondary",
        VendEstatesApp.Models.Enums.VehicleBookingStatus.Cancelled => "danger",
        _ => "warning"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Rental Booking - @Model.CustomerName</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Customer Name</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.CustomerPhone</dd>
            <dt class="col-sm-3">ID Number</dt>
            <dd class="col-sm-9">@(Model.CustomerIdNumber ?? "-")</dd>
            <dt class="col-sm-3">Vehicle</dt>
            <dd class="col-sm-9">@Model.Vehicle?.RegistrationNumber (@Model.Vehicle?.Make @Model.Vehicle?.Model)</dd>
            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Rental Days</dt>
            <dd class="col-sm-9">@Model.RentalDays</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-@statusBadge">@Model.Status</span></dd>
            <dt class="col-sm-3">Total Amount</dt>
            <dd class="col-sm-9">K@(Model.TotalAmount.ToString("N2"))</dd>
            <dt class="col-sm-3">Amount Paid</dt>
            <dd class="col-sm-9">K@(Model.AmountPaid.ToString("N2"))</dd>
            <dt class="col-sm-3">Balance</dt>
            <dd class="col-sm-9">K@(Model.Balance.ToString("N2"))</dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
        </dl>
    </div>
    @if (User.IsInRole("Director") || User.IsInRole("Manager"))
    {
        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
            @if (Model.Status == VendEstatesApp.Models.Enums.VehicleBookingStatus.Pending)
            {
                <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-play-circle"></i> Activate</button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-lg"></i> Cancel</button>
                </form>
            }
            @if (Model.Status == VendEstatesApp.Models.Enums.VehicleBookingStatus.Active)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-check-circle"></i> Complete</button>
                </form>
            }
        </div>
    }
</div>
