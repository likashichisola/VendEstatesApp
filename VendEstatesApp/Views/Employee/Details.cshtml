@model VendEstatesApp.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Details</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Role</span></dd>

            <dt class="col-sm-3">Job Title</dt>
            <dd class="col-sm-9">@Model.JobTitle</dd>

            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>

            <dt class="col-sm-3">Basic Salary</dt>
            <dd class="col-sm-9">@Model.BasicSalary.ToString("N2")</dd>

            <dt class="col-sm-3">Hire Date</dt>
            <dd class="col-sm-9">@Model.HireDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">NAPSA No.</dt>
            <dd class="col-sm-9">@(Model.NapsaNumber ?? "-")</dd>

            <dt class="col-sm-3">NHIMA No.</dt>
            <dd class="col-sm-9">@(Model.NhimaNumber ?? "-")</dd>

            <dt class="col-sm-3">TPIN</dt>
            <dd class="col-sm-9">@(Model.TpinNumber ?? "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        @if (User.IsInRole("Director") && Model.IsActive)
        {
            <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Deactivate this employee?');">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-person-dash"></i> Deactivate</button>
            </form>
        }
    </div>
</div>
