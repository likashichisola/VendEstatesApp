@model IEnumerable<VendEstatesApp.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employees</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Employee
    </a>
</div>

<div class="card">
    <div class="card-body table-responsive-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Branch</th>
                    <th>Job Title</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.FullName</td>
                        <td>@employee.Username</td>
                        <td><span class="badge bg-secondary">@employee.Role</span></td>
                        <td>@employee.Branch?.Name</td>
                        <td>@employee.JobTitle</td>
                        <td>
                            @if (employee.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
